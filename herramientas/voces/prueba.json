 "dialogos": [
  {
   "id": "DLG-034",
   "titulo": "Te presento a Dima",
   "lineas": [
    {
     "id": "DLG-034-01",
     "p": "masha",
     "ru": "Лу́кас, познако́мься, э́то Ди́ма.",
     "es": "Lucas, te presento a Dima.",
     "voces": [
      "baya",
      "kseniya",
      "xenia"
     ]
    },
    {
     "id": "DLG-034-02",
     "p": "lucas",
     "ru": "Приве́т, Ди́ма!",
     "es": "¡Hola, Dima!",
     "voces": [
      "aidar",
      "eugene"
     ]
    },
    {
     "id": "DLG-034-03",
     "p": "dima",
     "ru": "Приве́т! Рад познако́миться.",
     "es": "¡Hola! Encantado.",
     "voces": [
      "aidar",
      "eugene"
     ]
    },
    {
     "id": "DLG-034-04",
     "p": "lucas",
     "ru": "Я то́же. Ты ру́сский?",
     "es": "Yo también. ¿Eres ruso?",
     "voces": [
      "aidar",
      "eugene"
     ]
    },
    {
     "id": "DLG-034-05",
     "p": "dima",
     "ru": "Да. А ты?",
     "es": "Sí. ¿Y tú?",
     "voces": [
      "aidar",
      "eugene"
     ]
    },
    {
     "id": "DLG-034-06",
     "p": "lucas",
     "ru": "Я аргенти́нец.",
     "es": "Soy argentino.",
     "voces": [
      "aidar",
      "eugene"
     ]
    }
   ]
  },
  {
   "id": "DLG-033",
   "titulo": "Primera clase",
   "lineas": [
    {
     "id": "DLG-033-01",
     "p": "olga",
     "ru": "Здра́вствуйте! Как вас зову́т?",
     "es": "¡Buenos días! ¿Cómo se llama?",
     "voces": [
      "baya",
      "kseniya",
      "xenia"
     ]
    },
    {
     "id": "DLG-033-02",
     "p": "lucas",
     "ru": "Здра́вствуйте! Меня́ зову́т Лу́кас.",
     "es": "¡Buenos días! Me llamo Lucas.",
     "voces": [
      "aidar",
      "eugene"
     ]
    },
    {
     "id": "DLG-033-03",
     "p": "olga",
     "ru": "Отку́да вы?",
     "es": "¿De dónde es usted?",
     "voces": [
      "baya",
      "kseniya",
      "xenia"
     ]
    },
    {
     "id": "DLG-033-04",
     "p": "lucas",
     "ru": "Я из Аргенти́ны.",
     "es": "Soy de Argentina.",
     "voces": [
      "aidar",
      "eugene"
     ]
    },
    {
     "id": "DLG-033-05",
     "p": "olga",
     "ru": "Вы говори́те по-ру́сски?",
     "es": "¿Habla ruso?",
     "voces": [
      "baya",
      "kseniya",
      "xenia"
     ]
    },
    {
     "id": "DLG-033-06",
     "p": "lucas",
     "ru": "Да, немно́го. Я учу́ ру́сский.",
     "es": "Sí, un poco. Estudio ruso.",
     "voces": [
      "aidar",
      "eugene"
     ]
    },
    {
     "id": "DLG-033-07",
     "p": "olga",
     "ru": "Отли́чно!",
     "es": "¡Excelente!",
     "voces": [
      "baya",
      "kseniya",
      "xenia"
     ]
    }
   ]
  }
 ]
}